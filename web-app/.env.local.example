# Bragg — Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase — Local Development (from `supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-start-output>
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-from-supabase-start-output>

# api-cricket.com API
CRICKET_API_KEY=
CRICKET_API_BASE_URL=https://apiv2.api-cricket.com/cricket/
CRICKET_API_LEAGUE_KEY=

# App Config
# Local dev: http://localhost:3000 | Production: https://bragg-lemon.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Bragg
NEXT_PUBLIC_MOCK_MODE=true

# Server-side debug logging (set to true for local dev)
ENABLE_DEBUG_LOGS=true
