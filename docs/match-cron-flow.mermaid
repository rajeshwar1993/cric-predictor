%%{init: {'theme': 'dark', 'themeVariables': {'primaryColor': '#00D9FF', 'primaryTextColor': '#F1F5F9', 'lineColor': '#64748B', 'secondaryColor': '#1A1F26', 'tertiaryColor': '#0F1419'}}}%%

flowchart TD
    START([⏰ pg_cron fires every 1 min]) --> AUTH{Bearer token\nvalid?}
    AUTH -->|No| REJECT[401 Unauthorized]
    AUTH -->|Yes| WINDOW{2PM-1AM IST\nOR live matches?}
    WINDOW -->|No| INACTIVE[Return: inactive]
    WINDOW -->|Yes| FETCH_MATCHES[Query DB:\nmatches WHERE\ndate = today\nAND status IN\nupcoming, live]

    FETCH_MATCHES --> LOOP{For each\nmatch}
    LOOP -->|No matches| DONE[Return: ok, 0 matches]
    LOOP --> THROTTLE{last_polled_at\n< 50s ago?}
    THROTTLE -->|Yes| SKIP[Skip match] --> LOOP

    THROTTLE -->|No| STATUS{match.status?}

    %% ── UPCOMING PATH ──
    STATUS -->|upcoming| API_INFO[API: get_events\nevent_key=match_id]
    API_INFO --> TOSS{Toss happened?\nevent_live=1 OR\nevent_toss set}
    TOSS -->|No| UPDATE_POLL_1[Update matches:\nlast_polled_at = now] --> LOOP
    TOSS -->|Yes| TRANSITION

    subgraph TRANSITION [Match Start Transition]
        direction TB
        T1[Update matches:\nstatus = live\ntoss_winner = team_code\nlast_polled_at = now]
        T2[Update match_group_settings:\nis_locked = true\nfor ALL groups]
        T3[RPC: resolve_scenarios_by_category\ntoss_winner scenarios\n→ scenarios.is_resolved = true\n→ predictions.is_correct + points_earned]
        T1 --> T2 --> T3
    end
    TRANSITION --> LOOP

    %% ── LIVE PATH ──
    STATUS -->|live| API_LIVE[API: get_livescore\nmatch_key=match_id]
    API_LIVE --> WRITE_SNAPSHOT

    subgraph WRITE_SNAPSHOT [Write Live Snapshot to matches]
        direction TB
        S1["current_score_a = '185/4'"]
        S2["current_score_b = '120/3'"]
        S3[current_overs_a = 20.0]
        S4[current_overs_b = 14.2]
        S5[live_scorecard_json = full response]
        S6[last_polled_at = now]
    end

    WRITE_SNAPSHOT --> FINISHED{event_status\n= Finished?}

    %% ── STILL LIVE → PROGRESSIVE RESOLUTION ──
    FINISHED -->|No| PROGRESSIVE

    subgraph PROGRESSIVE [Progressive Resolution - each phase try/caught]
        direction TB
        P1{First wicket\nin wickets?}
        P1 -->|Yes| P1R[Resolve: first_wicket_over\nbracket: 1-2 / 3-4 / 5-6 / 7+]
        P1 -->|No| P2

        P1R --> P2{First innings\novers >= 6?}
        P2 -->|Yes| P2R[Resolve: powerplay_score\nbracket: <40 / 40-55 / 56-70 / 71+\n\nResolve: powerplay_wickets\nvalue: 0 / 1 / 2 / 3+]
        P2 -->|No| P3

        P2R --> P3{Any batsman\nR >= 50?}
        P3 -->|Yes| P3R[Resolve: batsman_fifty = Yes]
        P3 -->|No| P4

        P3R --> P4{Any bowler\nW >= 3?}
        P4 -->|Yes| P4R[Resolve: bowler_three_wkt = Yes]
        P4 -->|No| P5

        P4R --> P5{First innings\ncomplete?}
        P5 -->|Yes| P5R[Resolve: first_innings_score\nbracket: <150 / 150-169 / 170-189 / 190+]
        P5 -->|No| PEND[Done]
        P5R --> PEND
    end
    PROGRESSIVE --> LOOP

    %% ── MATCH COMPLETED ──
    FINISHED -->|Yes| COMPLETE

    subgraph COMPLETE [Match Completion]
        direction TB
        C1[Update matches:\nstatus = completed\nresolved_at = now\n\n── Result Fields ──\nmatch_winner\nplayer_of_match\ntop_scorer + runs\ntop_wicket_taker + wickets\nfirst_innings_score + wickets\ntotal_match_runs\ntotal_match_wickets\ntotal_match_sixes\npowerplay_score\npowerplay_wickets\nfirst_wicket_over\nmost_sixes_player\nhad_super_over\nbatsman_scored_fifty\nbowler_took_three]
        C2[RPC: resolve_match_predictions\n→ Resolves ALL remaining\nunresolved scenarios\n→ Scores ALL predictions\nis_correct + points_earned]
        C1 --> C2
    end
    COMPLETE --> LOOP

    %% ── STYLING ──
    style START fill:#00D9FF,color:#0F1419,stroke:none
    style REJECT fill:#EF4444,color:#fff,stroke:none
    style INACTIVE fill:#475569,color:#F1F5F9,stroke:none
    style DONE fill:#475569,color:#F1F5F9,stroke:none
    style SKIP fill:#475569,color:#F1F5F9,stroke:none

    style TRANSITION fill:#1E3A5F,color:#F1F5F9,stroke:#00D9FF
    style WRITE_SNAPSHOT fill:#1E3A5F,color:#F1F5F9,stroke:#64748B
    style PROGRESSIVE fill:#1E3A5F,color:#F1F5F9,stroke:#FBBF24
    style COMPLETE fill:#1E3A5F,color:#F1F5F9,stroke:#22C55E

    style T3 fill:#22C55E,color:#0F1419,stroke:none
    style C2 fill:#22C55E,color:#0F1419,stroke:none
    style P1R fill:#FBBF24,color:#0F1419,stroke:none
    style P2R fill:#FBBF24,color:#0F1419,stroke:none
    style P3R fill:#FBBF24,color:#0F1419,stroke:none
    style P4R fill:#FBBF24,color:#0F1419,stroke:none
    style P5R fill:#FBBF24,color:#0F1419,stroke:none
